{
  "name": "@absolutejs/blob",
  "version": "0.5.0",
  "description": "Object storage substrate for AbsoluteJS. One BlobStore interface with bounded streaming local and S3-compatible adapters, plus official AWS SDK wiring for multipart object storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/blob.git"
  },
  "homepage": "https://github.com/absolutejs/blob",
  "bugs": {
    "url": "https://github.com/absolutejs/blob/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "absolutejs": {
    "manifestContract": 2
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "default": "./dist/local.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js",
      "default": "./dist/s3.js"
    },
    "./aws-s3": {
      "types": "./dist/aws-s3.d.ts",
      "import": "./dist/aws-s3.js",
      "default": "./dist/aws-s3.js"
    },
    "./uploadthing": {
      "types": "./dist/uploadthing.d.ts",
      "import": "./dist/uploadthing.js",
      "default": "./dist/uploadthing.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js",
      "default": "./dist/inspection.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/local.ts src/s3.ts src/aws-s3.ts src/uploadthing.ts src/inspection.ts src/manifest.ts --outdir dist --root src --sourcemap --target=bun --external @aws-sdk/client-s3 --external @aws-sdk/lib-storage --external @aws-sdk/s3-request-presigner --external uploadthing && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "check:package": "bun run typecheck && bun run build && bun run test",
    "release": "bun run format && bun run check:package && bun publish"
  },
  "keywords": [
    "absolutejs",
    "blob",
    "object-storage",
    "s3",
    "r2",
    "b2",
    "minio"
  ],
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/lib-storage": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "bun-types": "^1.3.14",
    "uploadthing": "^7.7.4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "uploadthing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@aws-sdk/lib-storage": "3.1087.0",
    "@aws-sdk/s3-request-presigner": "3.1087.0",
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.3",
    "typescript": "^5.9.0",
    "uploadthing": "7.7.4"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.4.0",
    "@sinclair/typebox": "^0.34.0"
  }
}
